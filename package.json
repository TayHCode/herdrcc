{
  "name": "herdrcc",
  "version": "0.1.0",
  "description": "A web interface for Herdr: see which coding agents need you, chat with them, and approve their prompts from your phone over Tailscale.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TayHCode/herdrcc.git"
  },
  "bin": {
    "herdrcc": "bin/herdrcc.js",
    "herdr-control-center": "bin/herdrcc.js"
  },
  "files": [
    "bin/herdrcc.js",
    "dist/server/**",
    "dist/shared/**",
    "dist/client/**",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "docs/ARCHITECTURE.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "node bin/herdrcc.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "herdr",
    "ai-agents",
    "coding-agents",
    "dashboard",
    "tailscale",
    "codex",
    "claude-code"
  ],
  "homepage": "https://github.com/TayHCode/herdrcc#readme",
  "bugs": {
    "url": "https://github.com/TayHCode/herdrcc/issues"
  },
  "author": "TayHCode"
}
