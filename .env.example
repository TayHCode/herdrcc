# Optional path to the Herdr CLI. The default is `herdr` from PATH.
HERDR_CONTROL_CENTER_CLI=herdr

# Optional local port (default 4173). Avoid ports browsers block, such as 4190 or 6000.
HERDR_CONTROL_CENTER_PORT=4173

# Where paired devices are stored (default ~/.config/herdr-control-center).
# HERDR_CONTROL_CENTER_STATE_DIR=

# Tailnet address (host[:port]) that `tailscale serve` forwards here. Normally set by --remote.
# HERDR_CONTROL_CENTER_REMOTE_HOST=
